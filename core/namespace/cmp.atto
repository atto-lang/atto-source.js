// JS backend-owned core namespace: checked signed-i64 comparison only.
use namespace cmp;
pub fnc compare_int(int left, int right): int {
  if left < right; do return -1; fi
  if left > right; do return 1; fi
  return 0;
}
pub fnc compare_bool(bool left, bool right): int {
  if left == right; do return 0; fi
  if left; do return 1; fi
  return -1;
}
pub fnc min_int(int left, int right): int {
  if left <= right; do return left; fi
  return right;
}
pub fnc max_int(int left, int right): int {
  if left >= right; do return left; fi
  return right;
}
