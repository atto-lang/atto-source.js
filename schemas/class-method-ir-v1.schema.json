{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:oreslang:class-method-ir:v1",
  "title": "Oreslang experimental class-method IR v1",
  "description": "Structural contract only. src/class-method-ir-v1.mjs additionally validates reserved identifiers, signed-i64 range, duplicate receiver-erased selectors, body/result typing and argument-index bounds.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion","dialect","integerModel","classes"],
  "properties": {
    "schemaVersion": {"const": 1},
    "dialect": {"const": "oreslang.class-methods"},
    "integerModel": {"const": "signed-i64-checked-provisional"},
    "classes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {"$ref": "#/$defs/class"}
    }
  },
  "$defs": {
    "ident": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
    },
    "int": {
      "type": "string",
      "maxLength": 20,
      "pattern": "^(?:0|[1-9][0-9]*|-[1-9][0-9]*)$"
    },
    "class": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name","pub","methods"],
      "properties": {
        "name": {"$ref": "#/$defs/ident"},
        "pub": {"type": "boolean"},
        "methods": {
          "type": "array",
          "maxItems": 256,
          "items": {"$ref": "#/$defs/method"}
        }
      }
    },
    "method": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name","pub","paramTypes","resultType","body"],
      "properties": {
        "name": {"$ref": "#/$defs/ident"},
        "pub": {"type": "boolean"},
        "paramTypes": {
          "type": "array",
          "maxItems": 32,
          "items": {"const": "int"}
        },
        "resultType": {"enum": ["void","int"]},
        "body": {
          "oneOf": [
            {"$ref": "#/$defs/voidBody"},
            {"$ref": "#/$defs/literalBody"},
            {"$ref": "#/$defs/argBody"}
          ]
        }
      }
    },
    "voidBody": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {"kind": {"const": "void"}}
    },
    "literalBody": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind","value"],
      "properties": {
        "kind": {"const": "literal"},
        "value": {"$ref": "#/$defs/int"}
      }
    },
    "argBody": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind","index"],
      "properties": {
        "kind": {"const": "arg"},
        "index": {"type": "integer","minimum": 0,"maximum": 31}
      }
    }
  }
}
